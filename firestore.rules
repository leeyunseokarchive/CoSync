rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isTeamMember(teamId) {
      return isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.members;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      // Allow user to write to their profile, but prevent modifying subscription fields directly.
      // If resource == null (create), they shouldn't set plan to premium.
      allow create: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.get('plan', 'free') == 'free'
                    && request.resource.data.get('subscriptionStatus', 'expired') != 'active';
      allow update: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.get('plan', 'free') == resource.data.get('plan', 'free')
                    && request.resource.data.get('subscriptionStatus', 'expired') == resource.data.get('subscriptionStatus', 'expired');
    }

    match /teams/{teamId} {
      // get: 초대 코드로 teamId를 확보한 가입 전 사용자도 팀 정보를 확인해야 함.
      // list: 멤버인 팀만 (useTeams의 array-contains 쿼리와 일치) — 팀 열거 차단.
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.auth.uid in resource.data.members;
      // Existing members can update team fields freely; non-members may only
      // append themselves to members and touch NOTHING else (join flow).
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.members ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["members"])
          && request.resource.data.members == resource.data.members.concat([request.auth.uid]))
      );
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.members;

      match /members/{memberId} {
        allow read: if isTeamMember(teamId);
        allow write: if isTeamMember(teamId) && request.auth.uid == memberId;
      }

      match /consensus/{itemId} {
        allow read, write: if isTeamMember(teamId);

        match /comments/{commentId} {
          allow read: if isTeamMember(teamId);
          // 본인 이름으로만 작성 가능 (다른 사람 행세 방지)
          allow create: if isTeamMember(teamId) && request.resource.data.byUid == request.auth.uid;
          // 본인 댓글만 삭제 가능
          allow delete: if isTeamMember(teamId) && resource.data.byUid == request.auth.uid;
        }
      }

      match /agreements/{agreementId} {
        allow read, create: if isTeamMember(teamId);
        // Confirm flow: a member may only add/refresh THEIR OWN confirmation entry
        // (others' entries must be untouched), and may flip status to "confirmed"
        // only when every team member is present in confirmations.
        allow update: if isTeamMember(teamId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["confirmations", "status"])
          && request.resource.data.confirmations.diff(resource.data.get("confirmations", {})).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.confirmations[request.auth.uid] == request.time
          && (request.resource.data.get("status", "") == resource.data.get("status", "")
            || (request.resource.data.status == "confirmed"
              && get(/databases/$(database)/documents/teams/$(teamId)).data.members.hasOnly(request.resource.data.confirmations.keys())));
        // 재논의를 위해 미확정(pending) 합의안만 파기 가능. 확정본은 불변.
        allow delete: if isTeamMember(teamId) && resource.data.status == "pending_confirmation";
      }
    }

    match /inviteCodes/{code} {
      // get만 허용 — list를 열면 모든 초대코드+teamId가 열거된다.
      allow get: if isSignedIn();
      allow list: if false;
      // 해당 팀의 멤버만 자기 팀의 초대코드를 만들고 지울 수 있다.
      allow create: if isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.members;
      allow delete: if isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.members;
    }

    match /earlybird/{docId} {
      // 누구나 등록 가능, 읽기/수정/삭제는 서버 전용 (이메일 PII 보호)
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
