rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isTeamMember(teamId) {
      return isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.members;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      // Allow user to write to their profile, but prevent modifying subscription fields directly.
      // If resource == null (create), they shouldn't set plan to premium.
      allow create: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.get('plan', 'free') == 'free'
                    && request.resource.data.get('subscriptionStatus', 'expired') != 'active';
      allow update: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.get('plan', 'free') == resource.data.get('plan', 'free')
                    && request.resource.data.get('subscriptionStatus', 'expired') == resource.data.get('subscriptionStatus', 'expired');
    }

    match /teams/{teamId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.members;
      // Existing members can update team fields freely; non-members may only add themselves
      // (join flow, verified client-side against inviteCodes before calling this).
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.members ||
        request.resource.data.members == resource.data.members.concat([request.auth.uid])
      );
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.members;

      match /members/{memberId} {
        allow read: if isTeamMember(teamId);
        allow write: if isTeamMember(teamId) && request.auth.uid == memberId;
      }

      match /consensus/{itemId} {
        allow read, write: if isTeamMember(teamId);

        match /comments/{commentId} {
          allow read: if isTeamMember(teamId);
          // 본인 이름으로만 작성 가능 (다른 사람 행세 방지)
          allow create: if isTeamMember(teamId) && request.resource.data.byUid == request.auth.uid;
          // 본인 댓글만 삭제 가능
          allow delete: if isTeamMember(teamId) && resource.data.byUid == request.auth.uid;
        }
      }

      match /agreements/{agreementId} {
        allow read, create: if isTeamMember(teamId);
        // Confirm flow: a member may only write their own confirmation entry
        // (plus flip status to "confirmed", computed client-side once all members are in).
        allow update: if isTeamMember(teamId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["confirmations", "status"])
          && request.resource.data.confirmations[request.auth.uid] == request.time;
      }
    }

    match /inviteCodes/{code} {
      allow read: if isSignedIn();
      // Invite codes are created via Server Action or Admin SDK, but let's allow it for now if needed.
      allow create: if isSignedIn();
    }

    match /earlybird/{docId} {
      // Allow anyone to create, but not update existing ones
      allow create: if true;
      allow update: if false; // Server-only
      allow read: if isSignedIn();
    }
  }
}
